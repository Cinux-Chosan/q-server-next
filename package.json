{
  "name": "q-server-next",
  "version": "1.0.0",
  "description": "带登录鉴权的个人文件服务器 CLI：浏览目录 / 拖拽上传 / 单文件直下 / 多文件与目录自动打 zip。Fastify5 + Vue3/Vite6。",
  "type": "module",
  "license": "MIT",
  "keywords": ["file-server", "upload", "download", "zip", "cli", "static-server", "fastify"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cinux-Chosan/q-server-next.git"
  },
  "bin": {
    "q-server": "server/dist/index.js"
  },
  "files": [
    "server/dist",
    "web/dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite web",
    "build:web": "vite build web",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:web && npm run build:server",
    "prepublishOnly": "npm run build",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "archiver": "^7.0.1",
    "bytes": "^3.1.2",
    "commander": "^12.1.0",
    "fastify": "^5.2.0",
    "ms": "^2.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bytes": "^3.1.5",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue": "^3.5.13"
  }
}
